ENVIRONMENT=development
DEBUG=True

# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me

# URL-encode special characters in the password (for example @ becomes %40)
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/todo_db

# Browser origins allowed to call the API, comma-separated (set to your frontend URL in production)
# ALLOWED_ORIGINS=http://localhost:5173,https://your-site.netlify.app

# LLM for the AI features (any OpenAI-compatible API). Groq is the default.
# Create a free key at https://console.groq.com/keys
LLM_API_KEY=your-groq-api-key
# Optional overrides:
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=openai/gpt-oss-20b
